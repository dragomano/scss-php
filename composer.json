{
  "name": "bugo/scss-php",
  "description": "Pure PHP compiler for SCSS/Sass, fully compatible with the Dart Sass specification",
  "keywords": [
    "scss",
    "sass",
    "css",
    "compiler",
    "dart-sass",
    "pure-php"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bugo",
      "email": "bugo@dragomano.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Bugo\\SCSS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "bugo/iris": "^0.4",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/filesystem": "^7|^8"
  },
  "require-dev": {
    "axy/sourcemap": "^1.1",
    "bugo/sass-embedded-php": "^1.1",
    "bugo/scss-benchmark-utils": "dev-main",
    "dg/bypass-finals": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.95",
    "mockery/mockery": "^1.6.15",
    "monolog/monolog": "^3.10",
    "pestphp/pest": "^3|^4|^5",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.6",
    "scssphp/scssphp": "^2.1",
    "shyim/sasso-ffi": "^0.1.1",
    "symfony/cache": "^7|^8",
    "symfony/var-dumper": "^7|^8",
    "vimeo/psalm": "^6.16"
  },
  "scripts": {
    "fix": "vendor/bin/php-cs-fixer fix",
    "check": "vendor/bin/rector process --dry-run --clear-cache",
    "rector": "vendor/bin/rector process --clear-cache",
    "phpstan": "vendor/bin/phpstan analyse -l 10 src --memory-limit=512M --debug --no-progress",
    "psalm": "vendor/bin/psalm --stats --no-cache",
    "benchmark": "php benchmark.php 6",
    "test": "vendor/bin/pest --colors=always --display-warnings",
    "test-coverage": [
      "@putenv RUN_SASS_SPEC=1",
      "vendor/bin/pest -d memory_limit=2G --colors=always --coverage --min=100"
    ],
    "test-coverage-clover": "vendor/bin/pest --min=100 -d memory_limit=1G --coverage-clover coverage.xml",
    "test-coverage-html": "vendor/bin/pest --min=100 -d memory_limit=1G --coverage-html coverage",
    "test-mutate": "vendor/bin/pest --colors=always --mutate --clear-cache -d memory_limit=1G --path=src/Utils/UnitConverter.php tests/Unit/Utils/UnitConverterTest.php",
    "test-spec": [
      "@putenv RUN_SASS_SPEC=1",
      "Composer\\Config::disableProcessTimeout",
      "vendor/bin/pest tests/Feature/Compiler/SpecTest.php --colors=always"
    ],
    "update-spec": "php scripts/update-spec.php",
    "post-install-cmd": "php scripts/update-spec.php --if-missing",
    "post-update-cmd": "php scripts/update-spec.php --if-missing"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "bugo/sass-embedded-php": true,
      "pestphp/pest-plugin": true,
      "shyim/composer-binary-downloader": true
    }
  },
  "extra": {
    "allow-binaries": {
      "shyim/sasso-ffi": true
    }
  }
}
